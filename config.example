# Nomadys-PDF: copy to ~/.config/nomadys-pdf/config
# '#' starts a comment. Colours are #RRGGBB.

# Colour theme: gruvbox, tokyonight, catppuccin, rosepine, kanagawa,
# everforest, dracula, nord, solarized, or one of yours (:theme new NAME).
# \T in the app lists them with previews and writes this line for you.
# [light] / [dark] sections below it override single colours.
# include = gruvbox

theme = light              # dark | light (i toggles while reading)
autosave = true            # false: save only with Ctrl-s or :w
autosave_delay_ms = 1000
backup = true              # keep the file as it was before the first save of a session, as name.pdf.bak
restore_position = true    # reopen a file where you stopped reading
pdf_dirs = ~               # where \f looks for PDFs, comma separated: ~/Papers, ~/Books
cite_format = “%t” (p. %p)  # Y in the text cursor: %t the text, %p the page(s)
remember_view = true       # and with its own zoom, dark mode, two pages and rotation
show_tabs = false          # true: tab bar always visible (t toggles it)
page_shadow = true         # soft shadow around pages
mode_indicator = true      # small coloured badge with the mode (NORMAL, CURSOR, VISUAL, INSERT...)
dark_images = smart        # dark mode: smart (photos kept, figures on white recoloured), keep, invert
dark_text_weight = 2.5     # dark mode: how firm light letters and lines are (1 = plain inversion)
subpixel_text = false      # true: sharper text on LCD monitors
zoom = fit-width           # or a percentage, e.g. 125
# highlight colours for C V B N M (pastel yellow, red, green, pink, blue)
highlight_colors = #FFEE93, #FF9E9E, #A8E6A3, #FFB3DE, #A7C7F2
area_style = highlight     # areas/figures: highlight (like Acrobat) or frame
leader = \                 # leader key: \ , ; or "space"

# LaTeX inverse search (double click, Ctrl+click, Enter in the cursor):
# %l line, %c column, %f file
synctex_editor = nvim --headless -c "VimtexInverseSearch %l '%f'"

# y / Y in the free cursor copy / save a region as an image at this resolution
copy_dpi = 300

# UI font (tabs, help, panel, command line, comments, messages): any
# installed family; `fc-list : family` lists them (Nerd Fonts too, e.g.
# "CaskaydiaCove NF"). A name not found is reported, and a default is used.
font = monospace           # e.g. CaskaydiaCove NF, JetBrains Mono, DejaVu Sans
font_size = 10.5           # points

[light]
background = #D9D9D9       # around the pages
tab_bg = #ECECEC
tab_fg = #5A5A5A
tab_active_bg = #FFFFFF
tab_active_fg = #1E1E1E
tab_accent = #3C5488
bar_bg = #F4F4F4           # ':' and '/' line, comment prompt
bar_fg = #1E1E1E
bar_cursor = #3C5488
message_bg = #333333
message_fg = #FAFAFA
panel_bg = #FAFAFA
panel_fg = #222222
panel_selected_bg = #3C5488
panel_selected_fg = #FFFFFF
panel_header = #8A8A8A
comment_bg = #FFF8C4
comment_fg = #222222
comment_marker = #E64B35   # dot on highlights that have a comment
selection = #3C8CE7
search_match = #FF9D00
# hint_bg = #3C5488         # link letters (f, F); left out: the accent
# hint_fg = #FFFFFF         # their letters; left out: the ink that reads best
caret = #E64B35
form_focus = #4DBBD5
mode_normal = #7A7A7A
mode_cursor = #3C8CE7
mode_visual = #8E5CC7
mode_area = #E07A2E
mode_insert = #3E9E4F
mode_command = #C9A227
shadow = #000000

[dark]
background = #101010
tab_bg = #1A1A1A
tab_fg = #8A8A8A
tab_active_bg = #2E2E2E
tab_active_fg = #ECECEC
tab_accent = #4DBBD5
bar_bg = #1E1E1E
bar_fg = #ECECEC
bar_cursor = #4DBBD5
message_bg = #2A2A2A
message_fg = #ECECEC
panel_bg = #1C1C1C
panel_fg = #DADADA
panel_selected_bg = #2F4F6F
panel_selected_fg = #FFFFFF
panel_header = #7A7A7A
comment_bg = #2B2A1E
comment_fg = #F2EBC0
comment_marker = #F39B7F
selection = #3C8CE7
search_match = #FF9D00
caret = #F39B7F
form_focus = #4DBBD5
mode_normal = #6A6A6A
mode_cursor = #5AA2F0
mode_visual = #B08AE0
mode_area = #F39B5F
mode_insert = #6CC47E
mode_command = #E3C25A
page_bg = #1C1C1C          # dark mode: page paper colour
page_fg = #E4E4E4          # dark mode: page ink colour
shadow = #000000
