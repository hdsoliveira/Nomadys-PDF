# Nomadys-PDF: copy to ~/.config/nomadys-pdf/config
# '#' starts a comment. Colours are #RRGGBB.

# A ready-made colour theme (gruvbox, tokyonight, dracula, nord, solarized);
# settings below it override the theme.
# include = gruvbox

theme = light              # dark | light (i toggles while reading)
autosave = true            # false: save only with Ctrl-s or :w
autosave_delay_ms = 1000
restore_position = true    # reopen a file where you stopped reading
show_tabs = false          # true: tab bar always visible (t toggles it)
page_shadow = true         # soft shadow around pages
subpixel_text = false      # true: sharper text on LCD monitors
zoom = fit-width           # or a percentage, e.g. 125
# highlight colours for C V B N M (pastel yellow, red, green, pink, blue)
highlight_colors = #FFEE93, #FF9E9E, #A8E6A3, #FFB3DE, #A7C7F2
area_style = highlight     # areas/figures: highlight (like Acrobat) or frame
leader = \                 # leader key: \ , ; or "space"

# LaTeX inverse search (double click, Ctrl+click, Enter in the cursor):
# %l line, %c column, %f file
synctex_editor = nvim --headless -c "VimtexInverseSearch %l '%f'"

# UI font (tabs, command line, messages, panel): any installed font
font = monospace           # e.g. JetBrains Mono, DejaVu Sans, Go Mono
font_size = 10.5           # points

[light]
background = #D9D9D9       # around the pages
tab_bg = #ECECEC
tab_fg = #5A5A5A
tab_active_bg = #FFFFFF
tab_active_fg = #1E1E1E
tab_accent = #3C5488
bar_bg = #F4F4F4           # ':' and '/' line, comment prompt
bar_fg = #1E1E1E
bar_cursor = #3C5488
message_bg = #333333
message_fg = #FAFAFA
panel_bg = #FAFAFA
panel_fg = #222222
panel_selected_bg = #3C5488
panel_selected_fg = #FFFFFF
panel_header = #8A8A8A
comment_bg = #FFF8C4
comment_fg = #222222
comment_marker = #E64B35   # dot on highlights that have a comment
selection = #3C8CE7
search_match = #FF9D00
caret = #E64B35
form_focus = #4DBBD5
page_bg = #FFFFFF          # page paper (white + black ink = pages untouched)
page_fg = #000000          # page ink
shadow = #000000

[dark]
background = #101010
tab_bg = #1A1A1A
tab_fg = #8A8A8A
tab_active_bg = #2E2E2E
tab_active_fg = #ECECEC
tab_accent = #4DBBD5
bar_bg = #1E1E1E
bar_fg = #ECECEC
bar_cursor = #4DBBD5
message_bg = #2A2A2A
message_fg = #ECECEC
panel_bg = #1C1C1C
panel_fg = #DADADA
panel_selected_bg = #2F4F6F
panel_selected_fg = #FFFFFF
panel_header = #7A7A7A
comment_bg = #2B2A1E
comment_fg = #F2EBC0
comment_marker = #F39B7F
selection = #3C8CE7
search_match = #FF9D00
caret = #F39B7F
form_focus = #4DBBD5
page_bg = #1C1C1C          # dark mode: page paper colour
page_fg = #E4E4E4          # dark mode: page ink colour
shadow = #000000
