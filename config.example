# Nomadys-PDF: copy to ~/.config/nomadys-pdf/config
theme = light              # dark | light
autosave = true            # false: save only with Ctrl-s or :w
autosave_delay_ms = 1000
highlight_color = #FFE14D
zoom = fit-width           # or a percentage, e.g. 125
background_light = #D9D9D9
background_dark = #101010
dark_contrast_low = 28
dark_contrast_high = 228
